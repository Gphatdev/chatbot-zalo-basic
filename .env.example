# ==============================================================================
#  NKNP V3 — .env.example
#  Sao chép file này thành ".env" rồi chỉnh lại giá trị cho phù hợp.
#  (Cấu hình bổ sung mang phong cách NKNP — admin/support/prefix... nằm ở
#  config.yml, không cần khai báo lại ở đây.)
# ==============================================================================

# Tên bot hiển thị trên banner + dashboard. Để trống sẽ lấy name_bot trong config.yml.
BOT_NAME=NKNP V3

# Ký tự lệnh (prefix). Để trống sẽ lấy "prefix" trong config.yml.
BOT_PREFIX=!

# UID Zalo của chủ bot (owner, role cao nhất). Có thể để trống lần đầu chạy —
# log sẽ in ra UID sau khi đăng nhập, copy vào đây rồi khởi động lại.
OWNER_ZALO_ID=

# Đường dẫn lưu session đăng nhập (cookie) — để lần sau không cần quét QR lại.
SESSION_PATH=./App/Session.json
QR_PATH=./qr.png

# Đường dẫn database chính (EMPHAT — sql.js). DB "di sản" (Users/Threads của
# các lệnh port từ NKNP) nằm riêng tại Data/legacy/nknp-legacy.db, tự tạo.
DB_PATH=./Data/nknp-v3.db

# Cổng chạy dashboard web (server.js)
PORT=3000

# Mức log: debug | info | warn | error
LOG_LEVEL=info

# Danh sách domain được phép (không bị lọc bởi lệnh chống spam link), cách nhau bằng dấu phẩy
ANTI_LINK_ALLOWLIST=zalo.me,youtube.com,facebook.com

# ==============================================================================
#  BẢN QUYỀN / LICENSE — BẮT BUỘC
#  Bot sẽ KHÔNG khởi động (không đăng nhập Zalo, không load lệnh) nếu thiếu
#  hoặc sai 2 giá trị này. Được kiểm tra với server ngay khi bot khởi động,
#  xem App/License.js.
# ==============================================================================
API_TOKEN=
API_LICENSE=
